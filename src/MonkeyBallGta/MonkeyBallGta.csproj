<Project Sdk="Microsoft.NET.Sdk">
  <!-- ScriptHookVDotNet v3 script. Build output: bin/Release/net48/MonkeyBallGta.dll, copy it to <GTA V>/scripts/. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MonkeyBallGta</AssemblyName>
    <RootNamespace>MonkeyBallGta</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
